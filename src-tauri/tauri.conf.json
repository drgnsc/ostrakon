{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ostrakon",
  "version": "0.1.0",
  "identifier": "pl.orphalese.ostrakon",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Ostrakon",
        "width": 1180,
        "height": 820,
        "minWidth": 560,
        "minHeight": 420,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "visible": false,
        "useHttpsScheme": true,
        "zoomHotkeysEnabled": false
      }
    ],
    "security": {
      "freezePrototype": true,
      "capabilities": ["main"],
      "csp": {
        "default-src": "'none'",
        "script-src": "'self'",
        "style-src": "'self'",
        "font-src": "'self'",
        "img-src": "'self' https://art.localhost",
        "connect-src": "ipc: http://ipc.localhost https://ipc.localhost",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'",
        "object-src": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"],
    "category": "Productivity",
    "shortDescription": "Podglad plikow Markdown",
    "copyright": "Orphalese Solutions",
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown", "mkd"],
        "name": "Markdown",
        "description": "Dokument Markdown",
        "role": "Viewer"
      }
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Polish", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
